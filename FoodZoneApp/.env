# FoodZone API base. Override per environment.
#  - iOS simulator:        http://localhost:8000/api/v1
#  - Android emulator:     http://10.0.2.2:8000/api/v1
#  - Physical device:      http://<your-LAN-IP>:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Realtime (Laravel Reverb). Android emulator: use 10.0.2.2 as host.
EXPO_PUBLIC_REVERB_KEY=fzlocalkey
EXPO_PUBLIC_REVERB_HOST=localhost
EXPO_PUBLIC_REVERB_PORT=8080
EXPO_PUBLIC_REVERB_SCHEME=http
