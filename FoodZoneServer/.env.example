APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=foodzoneserver
DB_USERNAME=root
DB_PASSWORD=Admin@1120

# Dev defaults use the database/local drivers (no extra services required).
# PRODUCTION: switch the four drivers below to redis and run a queue worker
# (`php artisan queue:work redis`). predis is installed so REDIS_CLIENT=predis
# works without the PHP redis extension.
SESSION_DRIVER=database          # prod: redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log          # prod: reverb (run `php artisan reverb:start`)
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database         # prod: redis

CACHE_STORE=database             # prod: redis
# CACHE_PREFIX=

# Media uploads: local public disk in dev; set MEDIA_DISK=s3 (+ AWS_* / CDN url) in prod.
MEDIA_DISK=public

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis              # or phpredis if the extension is installed
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Search. Dev uses the DB-backed /search fallback (SCOUT_DRIVER=null).
# PRODUCTION: SCOUT_DRIVER=meilisearch, set host/key, then
# `php artisan scout:import "App\Models\Vendor"` (+ User, Post).
SCOUT_DRIVER=null
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=

# Real-time (Laravel Reverb / Pusher protocol). Dev uses BROADCAST_CONNECTION=log;
# clients fall back to polling when these are unset.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Client-side (forwarded to Vite/Next/Expo as public vars):
# NEXT_PUBLIC_REVERB_KEY / NEXT_PUBLIC_REVERB_HOST / NEXT_PUBLIC_REVERB_PORT
# EXPO_PUBLIC_REVERB_KEY / EXPO_PUBLIC_REVERB_HOST / EXPO_PUBLIC_REVERB_PORT

# Payments. Dev uses the `mock` gateway (full intent→confirm→refund flow, no
# external calls). PRODUCTION: set PAYMENT_GATEWAY=razorpay|stripe + the keys
# and webhook secret below; point the gateway dashboard webhook at
# POST /api/v1/payments/webhook and set PAYMENT_SIGNATURE_HEADER accordingly
# (X-Razorpay-Signature / Stripe-Signature).
PAYMENT_GATEWAY=mock
PAYMENT_CURRENCY=INR
PAYMENT_SIGNATURE_HEADER=X-Signature
PAYMENT_WEBHOOK_SECRET=mock_webhook_secret
# RAZORPAY_KEY=
# RAZORPAY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# STRIPE_KEY=
# STRIPE_SECRET=
# STRIPE_WEBHOOK_SECRET=

# Push notifications (Expo → FCM/APNs). Disabled in dev so no external calls.
# PRODUCTION: PUSH_ENABLED=true; Expo delivers via the credentials in your Expo
# project. EXPO_ACCESS_TOKEN is optional (higher rate limits).
PUSH_ENABLED=false
# EXPO_ACCESS_TOKEN=

# Hardening: API rate limiting (per-minute). Enabled by default; the test suite
# disables it via phpunit.xml. Security headers are always on.
HARDENING_RATE_LIMIT=true
RATE_LIMIT_API=120
RATE_LIMIT_AUTH=20

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
